# ledgerline configuration. Copy to .env and adjust: cp .env.example .env
# Every variable is optional; the defaults below are what the app uses when a value is empty or unset.

# --- RPC endpoints (Alchemy free tier recommended) --------------------------------------------
# Create a free account at https://www.alchemy.com, create one app and enable both
# "Ethereum Mainnet" and "Arbitrum Mainnet" on it. The same key works for both URLs.
# Alchemy is used for:
#   - archive state reads (daily / hourly history via Multicall3 at past blocks)
#   - ERC20 Transfer log scans (token discovery and the transactions ledger)
#   - native ETH transfers (alchemy_getAssetTransfers, only available on Alchemy URLs)
# Without these the app falls back to rate limited public endpoints: live balances work, but history
# backfills are slow and native ETH transfers are missing from the Activity view.
# Typical usage with 2-3 addresses and 5 minute snapshots is roughly 2M of the 30M free CU per month.
ETH_RPC_URL=
ARB_RPC_URL=
# Example: https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY and https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional separate archive endpoints for history reads (default: the URLs above, then public nodes).
# Set ARB_ARCHIVE_RPC_URL when a wallet was active on Arbitrum before 2022-09 (pre-Nitro state).
ETH_ARCHIVE_RPC_URL=
ARB_ARCHIVE_RPC_URL=

# --- Web server --------------------------------------------------------------------------------
# Used by `npm run dev` and `npm start`. Keep 127.0.0.1 unless a reverse proxy or VPN needs more.
HOST=127.0.0.1
PORT=8790

# --- Database ----------------------------------------------------------------------------------
# SQLite file shared by the web app and the worker (relative paths are resolved from the repo root).
DATABASE_PATH=./data/portfolio.db

# --- Worker schedule ---------------------------------------------------------------------------
# Live snapshot of all addresses (balances, Aave positions, prices)
SNAPSHOT_INTERVAL_MINUTES=15
# New token discovery (Transfer logs, token lists)
DISCOVERY_INTERVAL_MINUTES=60
# Transactions ledger sync (defaults to DISCOVERY_INTERVAL_MINUTES)
LEDGER_INTERVAL_MINUTES=60
# Daily price history and USD/CHF rates
PRICE_HISTORY_INTERVAL_HOURS=6
# Daily history backfill gap check
BACKFILL_INTERVAL_HOURS=6
# Retention rollup (live -> hourly -> daily)
ROLLUP_INTERVAL_MINUTES=60

# --- Hourly backfill ---------------------------------------------------------------------------
# Hours of hourly history to reconstruct for new addresses (168 = 7 days) and how often to check gaps
HOURLY_BACKFILL_HOURS=168
HOURLY_BACKFILL_INTERVAL_HOURS=6

# --- Retention ---------------------------------------------------------------------------------
# Live snapshots are kept this many days, then rolled up to hourly; hourly is kept this many days,
# then only daily points remain (daily history is kept forever).
RETENTION_RAW_DAYS=30
RETENTION_HOURLY_DAYS=365

# --- Logging -----------------------------------------------------------------------------------
# debug | info | warn | error. LOG_FORMAT=json|text (default: json when stdout is not a terminal)
LOG_LEVEL=info
LOG_FORMAT=
